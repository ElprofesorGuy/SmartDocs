<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartDocs.Views.ArchivesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartDocs.Controls"
             xmlns:helpers="clr-namespace:SmartDocs.Helpers"
             xmlns:models="clr-namespace:SmartDocs.Models"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">

        <!-- Barre supérieure -->
        <Grid Style="{StaticResource TopBar}" ColumnDefinitions="48,*,40,40" HeightRequest="64">
            <Label Text="{x:Static helpers:Icons.Menu}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMenuTapped" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Archives" Style="{StaticResource H2}" FontSize="20" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{x:Static helpers:Icons.Tune}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnSortTapped" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="3" Text="{x:Static helpers:Icons.HelpOutline}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnHelpTapped" /></Label.GestureRecognizers>
            </Label>
        </Grid>

        <CollectionView x:Name="ArchiveList" Grid.Row="1" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="14" Padding="16,12,16,12">

                    <!-- Carte de synthèse -->
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource AccentLight}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Start">
                                <Label Text="{x:Static helpers:Icons.Archive}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="TotalLabel" Text="0 document" Style="{StaticResource H2}" FontSize="20" />
                                <Label Text="Espace d'archivage sécurisé" Style="{StaticResource Caption}" FontSize="13" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="End">
                                <controls:Badge x:Name="UsedBadge" Text="0 Mo utilisés" TextColor="{StaticResource PrimaryStrong}" BackgroundColor="#E0E7FF" HorizontalOptions="End" />
                                <Label Text="Rétention 5 à 10 ans" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Recherche -->
                    <Border x:Name="SearchBorder" Style="{StaticResource Field}" HeightRequest="48">
                        <Grid ColumnDefinitions="44,*,44">
                            <Label Text="{x:Static helpers:Icons.Search}" Style="{StaticResource Icon}" FontSize="22" />
                            <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Rechercher dans les archives…" TextChanged="OnSearchChanged" ReturnType="Search" />
                            <Label Grid.Column="2" Text="{x:Static helpers:Icons.Mic}" Style="{StaticResource Icon}" FontSize="22">
                                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMicTapped" /></Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <!-- Pastilles par année -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="-16,0">
                        <HorizontalStackLayout x:Name="YearChips" Spacing="8" Padding="16,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ChipItem">
                                    <Border BackgroundColor="{Binding Fill}" Stroke="{Binding Outline}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18" Padding="16,0" HeightRequest="36">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipTapped" /></Border.GestureRecognizers>
                                        <Label Text="{Binding Display}" TextColor="{Binding Foreground}" FontFamily="InterMedium" FontSize="14" VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <Label Text="PIÈCES SCELLÉES &amp; HISTORISÉES" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="2">
                            <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnSortTapped" /></HorizontalStackLayout.GestureRecognizers>
                            <Label x:Name="SortLabel" Text="Trier par date" Style="{StaticResource Link}" FontSize="12" VerticalOptions="Center" />
                            <Label x:Name="SortArrow" Text="{x:Static helpers:Icons.ArrowDownward}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}" FontSize="14" />
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Aucune pièce archivée ne correspond." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,30,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DocumentItem">
                    <Border Style="{StaticResource Card}" Margin="16,0" Padding="16,14">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCardTapped" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <controls:FileTile Glyph="{Binding FileGlyph}" Fg="{Binding FileColor}" Bg="{Binding FileBg}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Label Text="{Binding Name}" Style="{StaticResource TitleSm}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
                                        <controls:Badge Grid.Column="1" Text="Archivé" TextColor="{StaticResource TextSecondary}" BackgroundColor="{StaticResource NeutralBg}" />
                                    </Grid>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Category}" TextColor="{Binding CategoryFg}" FontFamily="InterMedium" FontSize="13" />
                                        <Label Text="•" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding SizeText}" Style="{StaticResource Caption}" FontSize="13" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{x:Static helpers:Icons.MoreVert}" Style="{StaticResource Icon}" VerticalOptions="Start" WidthRequest="28">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMoreTapped" /></Label.GestureRecognizers>
                                </Label>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource NeutralBg}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{x:Static helpers:Icons.History}" Style="{StaticResource Icon}" FontSize="16" />
                                    <Label Text="{Binding ArchivedText}" Style="{StaticResource Caption}" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <controls:AppButton Grid.Column="1" Text="Restaurer" Glyph="{x:Static helpers:Icons.Unarchive}"
                                                    Variant="OutlinePrimary" Compact="True" Clicked="OnRestoreClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
