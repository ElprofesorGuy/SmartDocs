<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartDocs.Views.RegisterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartDocs.Controls"
             xmlns:helpers="clr-namespace:SmartDocs.Helpers"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">

        <!-- Barre supérieure -->
        <Grid Style="{StaticResource TopBar}" ColumnDefinitions="48,*,Auto" ColumnSpacing="4" HeightRequest="60">
            <Label Text="{x:Static helpers:Icons.ArrowBack}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="36" HeightRequest="36" BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 9">
                    <Label Text="{x:Static helpers:Icons.Description}" Style="{StaticResource Icon}" TextColor="White" FontSize="20" />
                </Border>
                <Label Text="SmartDocs" FontFamily="InterBold" FontSize="20" TextColor="{StaticResource PrimaryDark}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <controls:Badge Grid.Column="2" Text="● ENTREPRISE" TextColor="{StaticResource PrimaryDark}" BackgroundColor="#E0E7FF" Margin="0,0,8,0" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,20,16,24" Spacing="18">

                <VerticalStackLayout Spacing="4">
                    <Label Text="Créer un compte" Style="{StaticResource H1}" />
                    <Label Text="L'inscription se fait sur invitation : saisissez le code reçu de votre administrateur." Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <!-- Code d'invitation (obligatoire) -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Code d'invitation" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="CodeBorder" Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="44,*,40">
                            <Label Text="{x:Static helpers:Icons.VpnKey}" Style="{StaticResource Icon}" FontSize="22" />
                            <Entry x:Name="CodeEntry" Grid.Column="1" Placeholder="XXXXX-XXXXX" Keyboard="Plain" MaxLength="20" TextChanged="OnFormChanged" />
                            <Label x:Name="CodeCheck" Grid.Column="2" Text="{x:Static helpers:Icons.CheckCircle}" Style="{StaticResource Icon}"
                                   TextColor="{StaticResource Success}" FontSize="22" IsVisible="False" />
                        </Grid>
                    </Border>
                    <Label Text="Votre rôle est défini par l'invitation. Si elle est réservée à une adresse e-mail, utilisez cette adresse ci-dessous."
                           Style="{StaticResource Caption}" FontSize="12" />
                </VerticalStackLayout>

                <!-- Nom complet -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nom complet" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="NameBorder" Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="44,*">
                            <Label Text="{x:Static helpers:Icons.PersonOutline}" Style="{StaticResource Icon}" FontSize="22" />
                            <Entry x:Name="NameEntry" Grid.Column="1" Placeholder="Prénom Nom" TextChanged="OnFormChanged" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- E-mail -->
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="E-mail professionnel" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                        <HorizontalStackLayout x:Name="EmailOkHint" Grid.Column="1" Spacing="4" IsVisible="False">
                            <Label Text="{x:Static helpers:Icons.Verified}" Style="{StaticResource Icon}" TextColor="{StaticResource Success}" FontSize="14" />
                            <Label Text="Format vérifié" TextColor="{StaticResource Success}" FontFamily="InterMedium" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                    <Border x:Name="EmailBorder" Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="44,*,40">
                            <Label Text="{x:Static helpers:Icons.MailOutline}" Style="{StaticResource Icon}" FontSize="22" />
                            <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="prenom.nom@entreprise.com" Keyboard="Email" TextChanged="OnFormChanged" />
                            <Label x:Name="EmailCheck" Grid.Column="2" Text="{x:Static helpers:Icons.CheckCircle}" Style="{StaticResource Icon}"
                                   TextColor="{StaticResource Success}" FontSize="22" IsVisible="False" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Mot de passe -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mot de passe" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="PasswordBorder" Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="44,*,44">
                            <Label Text="{x:Static helpers:Icons.Lock}" Style="{StaticResource Icon}" FontSize="22" />
                            <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Créez un mot de passe" IsPassword="True" TextChanged="OnFormChanged" />
                            <Label x:Name="EyeLabel" Grid.Column="2" Text="{x:Static helpers:Icons.Visibility}" Style="{StaticResource Icon}" FontSize="22">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTogglePassword" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="6">
                        <BoxView x:Name="Bar1" HeightRequest="4" CornerRadius="2" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                        <BoxView x:Name="Bar2" Grid.Column="1" HeightRequest="4" CornerRadius="2" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                        <BoxView x:Name="Bar3" Grid.Column="2" HeightRequest="4" CornerRadius="2" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                        <Label x:Name="StrengthLabel" Grid.Column="3" Text="" FontFamily="InterMedium" FontSize="12" VerticalOptions="Center" MinimumWidthRequest="56" HorizontalTextAlignment="End" />
                    </Grid>

                    <HorizontalStackLayout Spacing="8">
                        <controls:Badge x:Name="RuleLength" Text="8+ caractères" Glyph="{x:Static helpers:Icons.CheckCircle}" />
                        <controls:Badge x:Name="RuleUpper" Text="Majuscule" Glyph="{x:Static helpers:Icons.CheckCircle}" />
                        <controls:Badge x:Name="RuleDigit" Text="Chiffre" Glyph="{x:Static helpers:Icons.CheckCircle}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Confirmation -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Confirmer le mot de passe" Style="{StaticResource FieldLabel}" />
                    <Border x:Name="ConfirmBorder" Style="{StaticResource Field}">
                        <Grid ColumnDefinitions="44,*,40">
                            <Label Text="{x:Static helpers:Icons.LockClock}" Style="{StaticResource Icon}" FontSize="22" />
                            <Entry x:Name="ConfirmEntry" Grid.Column="1" Placeholder="Répétez le mot de passe" IsPassword="True" TextChanged="OnFormChanged" />
                            <Label x:Name="ConfirmCheck" Grid.Column="2" Text="{x:Static helpers:Icons.Check}" Style="{StaticResource Icon}"
                                   TextColor="{StaticResource Success}" FontSize="22" IsVisible="False" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Conditions -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <CheckBox x:Name="TermsCheck" VerticalOptions="Start" Margin="-6,-6,0,0" CheckedChanged="OnTermsChanged" />
                    <Label Grid.Column="1" FontSize="13" LineHeight="1.3" Margin="0,2,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="J'accepte les " />
                                <Span Text="conditions d'utilisation" TextColor="{StaticResource PrimaryStrong}" TextDecorations="Underline" />
                                <Span Text=" et la " />
                                <Span Text="politique de confidentialité" TextColor="{StaticResource PrimaryStrong}" TextDecorations="Underline" />
                                <Span Text="." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </Grid>

                <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{StaticResource Danger}" FontSize="12" />

                <controls:AppButton x:Name="SubmitButton" Text="S'inscrire" Glyph="{x:Static helpers:Icons.ArrowForward}"
                                    IconAtEnd="True" IsEnabled="False" Clicked="OnSubmitClicked" />

                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,12,0,0" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <Label Text="Déjà un compte ?" Style="{StaticResource Muted}" FontSize="13" VerticalOptions="Center" />
                    <Label Text="Se connecter" Style="{StaticResource Link}" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
