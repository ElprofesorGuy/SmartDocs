<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartDocs.Views.InvitationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartDocs.Controls"
             xmlns:helpers="clr-namespace:SmartDocs.Helpers"
             xmlns:models="clr-namespace:SmartDocs.Models"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">

        <Grid Style="{StaticResource TopBar}" ColumnDefinitions="48,*,48" HeightRequest="60">
            <Label Text="{x:Static helpers:Icons.ArrowBack}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Invitations" Style="{StaticResource TitleMd}" FontSize="18" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="{x:Static helpers:Icons.Add}" Style="{StaticResource Icon}" TextColor="{StaticResource PrimaryStrong}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnAddTapped" /></Label.GestureRecognizers>
            </Label>
        </Grid>

        <CollectionView x:Name="InvitationsList" Grid.Row="1" SelectionMode="None" Margin="16,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Label Text="Personne ne peut créer de compte sans invitation. Touchez + pour en créer une, puis transmettez le code à la personne invitée. Chaque code ne sert qu'une fois."
                       Style="{StaticResource Caption}" FontSize="13" Margin="0,12,0,12" />
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Aucune invitation pour le moment." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,30,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:InvitationItem">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnItemTapped" /></Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{Binding StatusBg}" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12" VerticalOptions="Start">
                                <Label Text="{x:Static helpers:Icons.MailOutline}" Style="{StaticResource Icon}" TextColor="{Binding StatusFg}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="{Binding Code}" Style="{StaticResource TitleSm}" FontSize="16" />
                                <Label Text="{Binding RoleText}" FontFamily="InterMedium" FontSize="13" />
                                <Label Text="{Binding Target}" Style="{StaticResource Caption}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding DateText}" Style="{StaticResource Caption}" FontSize="12" />
                                <controls:Badge Text="{Binding StatusLabel}" TextColor="{Binding StatusFg}" BackgroundColor="{Binding StatusBg}" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
