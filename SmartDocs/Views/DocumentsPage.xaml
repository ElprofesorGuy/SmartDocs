<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartDocs.Views.DocumentsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartDocs.Controls"
             xmlns:helpers="clr-namespace:SmartDocs.Helpers"
             xmlns:models="clr-namespace:SmartDocs.Models"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- En-tête -->
            <Grid Style="{StaticResource TopBar}" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" HeightRequest="64" Padding="16,8">
                <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                    <Label Text="{x:Static helpers:Icons.FolderSpecial}" Style="{StaticResource Icon}" TextColor="White" FontSize="22" />
                </Border>
                <Label Grid.Column="1" Text="Documents" Style="{StaticResource H2}" FontSize="21" VerticalOptions="Center" />
                <Label Grid.Column="2" Text="{x:Static helpers:Icons.Sort}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}" WidthRequest="36">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnSortTapped" /></Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="3" Text="{x:Static helpers:Icons.Tune}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}" WidthRequest="36">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnFilterTapped" /></Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="4" Text="{x:Static helpers:Icons.PersonOutline}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}" WidthRequest="36">
                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnAccountTapped" /></Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Recherche + filtre -->
            <Grid Grid.Row="1" ColumnDefinitions="*,48" ColumnSpacing="10" Padding="16,12,16,0">
                <Border Style="{StaticResource Field}" HeightRequest="48">
                    <Grid ColumnDefinitions="44,*">
                        <Label Text="{x:Static helpers:Icons.Search}" Style="{StaticResource Icon}" FontSize="22" />
                        <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Rechercher par titre, mot-clé…" TextChanged="OnSearchChanged" ReturnType="Search" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" x:Name="FilterButton" Style="{StaticResource Field}" WidthRequest="48" HeightRequest="48">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFilterTapped" /></Border.GestureRecognizers>
                    <Label Text="{x:Static helpers:Icons.FilterAlt}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}" FontSize="22" />
                </Border>
            </Grid>

            <!-- Pastilles de catégories -->
            <ScrollView Grid.Row="2" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,12,0,0">
                <HorizontalStackLayout x:Name="ChipsLayout" Spacing="8" Padding="16,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ChipItem">
                            <Border BackgroundColor="{Binding Fill}" Stroke="{Binding Outline}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18" Padding="16,0" HeightRequest="36">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnChipTapped" /></Border.GestureRecognizers>
                                <Label Text="{Binding Display}" TextColor="{Binding Foreground}" FontFamily="InterMedium" FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Compteur + tri -->
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Padding="16,14,16,10">
                <Label x:Name="CountLabel" Text="" Style="{StaticResource TitleSm}" TextColor="{StaticResource TextSecondary}" FontFamily="InterMedium" VerticalOptions="Center" />
                <HorizontalStackLayout Grid.Column="1" Spacing="2">
                    <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnSortTapped" /></HorizontalStackLayout.GestureRecognizers>
                    <Label x:Name="SortLabel" Text="Récents" Style="{StaticResource Caption}" FontFamily="InterMedium" FontSize="13" VerticalOptions="Center" />
                    <Label Text="{x:Static helpers:Icons.ExpandMore}" Style="{StaticResource Icon}" FontSize="18" />
                </HorizontalStackLayout>
            </Grid>

            <!-- Liste -->
            <CollectionView x:Name="DocsList" Grid.Row="4" SelectionMode="None" Margin="16,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <Label Text="Aucun document ne correspond à votre recherche." Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" Margin="0,40,0,0" />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="88" Color="Transparent" />
                </CollectionView.Footer>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DocumentItem">
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCardTapped" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <controls:FileTile Glyph="{Binding FileGlyph}" Fg="{Binding FileColor}" Bg="{Binding FileBg}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <controls:Badge Text="{Binding Category}" TextColor="{Binding CategoryFg}" BackgroundColor="{Binding CategoryBg}" />
                                            <Label Grid.Column="1" Text="{Binding DateText}" Style="{StaticResource Caption}" FontSize="12" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Name}" Style="{StaticResource TitleSm}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding ListMeta}" Style="{StaticResource Caption}" LineBreakMode="TailTruncation" MaxLines="1" />
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{StaticResource NeutralBg}" />
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <controls:AppButton Text="Voir" Glyph="{x:Static helpers:Icons.Visibility}" Variant="Soft" Compact="True" Clicked="OnViewClicked" WidthRequest="84" />
                                    <controls:AppButton Grid.Column="1" Text="Télécharger" Glyph="{x:Static helpers:Icons.Download}" Variant="Outline" Compact="True" Clicked="OnDownloadClicked" />
                                    <Label Grid.Column="3" Text="{x:Static helpers:Icons.MoreVert}" Style="{StaticResource Icon}" WidthRequest="40" VerticalOptions="Center">
                                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnMoreTapped" /></Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <!-- Bouton flottant -->
        <Border x:Name="Fab" HorizontalOptions="Center" VerticalOptions="End" Margin="0,0,0,16" HeightRequest="52" Padding="22,0"
                BackgroundColor="{StaticResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 26">
            <Border.Shadow>
                <Shadow Brush="#2563EB" Opacity="0.35" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFabTapped" /></Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="{x:Static helpers:Icons.Add}" Style="{StaticResource Icon}" TextColor="White" FontSize="22" />
                <Label Text="Déposer un document" FontFamily="InterSemiBold" TextColor="White" FontSize="15" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
