<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartDocs.Views.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartDocs.Controls"
             xmlns:helpers="clr-namespace:SmartDocs.Helpers"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="16,40,16,24" Spacing="24">

            <!-- Marque -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Grid WidthRequest="76" HeightRequest="76" HorizontalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64" HorizontalOptions="Center" VerticalOptions="Center"
                            StrokeThickness="0" Stroke="Transparent" StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0.0" />
                                <GradientStop Color="#1E40AF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="{x:Static helpers:Icons.FolderSpecial}" Style="{StaticResource Icon}"
                               TextColor="White" FontSize="32" />
                    </Border>
                    <Border WidthRequest="24" HeightRequest="24" HorizontalOptions="End" VerticalOptions="End"
                            BackgroundColor="White" Stroke="{StaticResource AccentBorder}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="0">
                        <Label Text="{x:Static helpers:Icons.Verified}" Style="{StaticResource Icon}"
                               TextColor="{StaticResource Primary}" FontSize="16" />
                    </Border>
                </Grid>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="SmartDocs" FontFamily="InterBold" FontSize="20" VerticalOptions="Center" />
                    <controls:Badge Text="ENTREPRISE" TextColor="{StaticResource PrimaryDark}" BackgroundColor="#E0E7FF" />
                </HorizontalStackLayout>
                <Label Text="Espace documentaire sécurisé &amp; gouvernance d'entreprise" Style="{StaticResource Muted}"
                       FontSize="13" HorizontalTextAlignment="Center" MaximumWidthRequest="260" />
            </VerticalStackLayout>

            <!-- Carte de connexion -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Connexion" Style="{StaticResource H2}" FontSize="20" VerticalOptions="Center" />
                            <Border Grid.Column="1" BackgroundColor="{StaticResource NeutralBg}" Stroke="#E2E8F0" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="8,3" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="5">
                                    <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="#10B981" VerticalOptions="Center" />
                                    <Label Text="Portail Actif" Style="{StaticResource Caption}" FontSize="11" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                        <Label Text="Renseignez vos identifiants professionnels pour continuer" Style="{StaticResource Muted}" FontSize="13" />
                    </VerticalStackLayout>

                    <!-- E-mail -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Adresse e-mail professionnelle" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="EmailBorder" Style="{StaticResource Field}">
                            <Grid ColumnDefinitions="44,*">
                                <Label Text="{x:Static helpers:Icons.MailOutline}" Style="{StaticResource Icon}" FontSize="22" />
                                <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="prenom.nom@entreprise.com"
                                       Keyboard="Email" ReturnType="Next" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Mot de passe -->
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Mot de passe" Style="{StaticResource FieldLabel}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Mot de passe oublié ?" Style="{StaticResource Link}" FontSize="12">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnForgotPassword" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Border x:Name="PasswordBorder" Style="{StaticResource Field}">
                            <Grid ColumnDefinitions="44,*,44">
                                <Label Text="{x:Static helpers:Icons.Lock}" Style="{StaticResource Icon}" FontSize="22" />
                                <Entry x:Name="PasswordEntry" Grid.Column="1" Placeholder="Votre mot de passe" IsPassword="True"
                                       ReturnType="Done" Completed="OnLoginClicked" />
                                <Label x:Name="EyeLabel" Grid.Column="2" Text="{x:Static helpers:Icons.Visibility}" Style="{StaticResource Icon}" FontSize="22">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTogglePassword" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Label x:Name="ErrorLabel" IsVisible="False" TextColor="{StaticResource Danger}" FontSize="12" />

                    <controls:AppButton x:Name="LoginButton" Text="Se connecter" Glyph="{x:Static helpers:Icons.ArrowForward}"
                                        IconAtEnd="True" Clicked="OnLoginClicked" />

                    <!-- Séparateur -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Ou connectez-vous avec votre compte d'entreprise" Style="{StaticResource Caption}"
                               FontSize="11" MaximumWidthRequest="210" HorizontalTextAlignment="Center" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{StaticResource BorderColor}" VerticalOptions="Center" />
                    </Grid>

                    <!-- Microsoft 365 (simulé) -->
                    <Border Style="{StaticResource Field}" HeightRequest="48">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMicrosoftTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                            <Grid WidthRequest="20" HeightRequest="20" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="1" ColumnSpacing="1" VerticalOptions="Center">
                                <BoxView Color="#F25022" />
                                <BoxView Grid.Column="1" Color="#7FBA00" />
                                <BoxView Grid.Row="1" Color="#00A4EF" />
                                <BoxView Grid.Row="1" Grid.Column="1" Color="#FFB900" />
                            </Grid>
                            <Label Text="Continuer avec Microsoft 365" FontFamily="InterMedium" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                        <Label Text="{x:Static helpers:Icons.Business}" Style="{StaticResource Icon}" FontSize="16" />
                        <Label Text="Autre fournisseur SAML / Okta SSO" Style="{StaticResource Caption}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMicrosoftTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,24,0,0">
                <Label Text="Vous n'avez pas encore de compte ?" Style="{StaticResource Muted}" FontSize="13" />
                <Label Text="S'inscrire" Style="{StaticResource Link}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
