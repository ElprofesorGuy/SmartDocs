<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SmartDocs.Views.TrashPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SmartDocs.Controls"
             xmlns:helpers="clr-namespace:SmartDocs.Helpers"
             xmlns:models="clr-namespace:SmartDocs.Models"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">

        <Grid Style="{StaticResource TopBar}" ColumnDefinitions="48,*" HeightRequest="60">
            <Label Text="{x:Static helpers:Icons.ArrowBack}" Style="{StaticResource Icon}" TextColor="{StaticResource TextPrimary}">
                <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped" /></Label.GestureRecognizers>
            </Label>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="Corbeille" Style="{StaticResource TitleMd}" FontSize="18" />
                <Label x:Name="CountLabel" Text="0 document" Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </Grid>

        <CollectionView x:Name="TrashList" Grid.Row="1" SelectionMode="None" Margin="16,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <Border BackgroundColor="{StaticResource AccentLight}" Stroke="{StaticResource AccentBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="12,10" Margin="0,12,0,12">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{x:Static helpers:Icons.InfoOutline}" Style="{StaticResource Icon}" TextColor="{StaticResource Primary}" FontSize="20" VerticalOptions="Start" />
                        <Label Text="Les documents supprimés restent récupérables. « Restaurer » les remet là où ils étaient (Documents ou Archives). La suppression définitive est irréversible."
                               TextColor="{StaticResource PrimaryDark}" FontSize="13" LineHeight="1.25" WidthRequest="290" />
                    </HorizontalStackLayout>
                </Border>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="La corbeille est vide." Style="{StaticResource Muted}" HorizontalTextAlignment="Center" Margin="0,30,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <BoxView HeightRequest="16" Color="Transparent" />
            </CollectionView.Footer>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DocumentItem">
                    <Border Style="{StaticResource Card}" Padding="16,14">
                        <VerticalStackLayout Spacing="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:FileTile Glyph="{Binding FileGlyph}" Fg="{Binding FileColor}" Bg="{Binding FileBg}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Name}" Style="{StaticResource TitleSm}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Category}" TextColor="{Binding CategoryFg}" FontFamily="InterMedium" FontSize="13" />
                                        <Label Text="•" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding SizeText}" Style="{StaticResource Caption}" FontSize="13" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource NeutralBg}" />
                            <Label Text="{Binding DeletedText}" Style="{StaticResource Caption}" FontSize="13" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <controls:AppButton Text="Restaurer" Glyph="{x:Static helpers:Icons.Restore}"
                                                    Variant="OutlinePrimary" Compact="True" IsVisible="{Binding CanDelete}" Clicked="OnRestoreClicked" />
                                <controls:AppButton Grid.Column="1" Text="Supprimer" Glyph="{x:Static helpers:Icons.DeleteForever}"
                                                    Variant="DangerOutline" Compact="True" IsVisible="{Binding CanPurge}" Clicked="OnPurgeClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
