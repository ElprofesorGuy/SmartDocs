<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android + Windows (Windows seulement si on compile depuis Windows). iOS / Mac Catalyst non inclus. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>SmartDocs</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Les API DisplayAlert / DisplayActionSheet sont simplement marquées obsolètes en .NET 10 : on masque l'avertissement -->
		<NoWarn>$(NoWarn);CS0618</NoWarn>

		<ApplicationTitle>SmartDocs</ApplicationTitle>
		<ApplicationId>com.smartdocs.app</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Lancement direct « Machine Windows » sans empaquetage MSIX (pas de certificat à gérer) -->
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône d'application et écran de démarrage -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1E3A8A" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F8F9FF" BaseSize="128,128" />

		<!-- Polices embarquées (Inter + Material Icons Outlined) : aucun accès réseau nécessaire -->
		<MauiFont Include="Resources\Fonts\*" />

		<MauiImage Include="Resources\Images\*.png;Resources\Images\*.svg;Resources\Images\*.jpg" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

</Project>
